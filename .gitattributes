# Auto detect text files
* text=auto

# LF for Linux/macOS
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# CRLF for Windows scripts
*.bat text eol=crlf

# Java
*.java text diff=java

# Maven
pom.xml text

# Docker
Dockerfile text

# React
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.css text
*.scss text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
*.zip binary

# Shell scripts executable
*.sh linguist-language=Shell